{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // Tests and their helpers run straight from TypeScript under vitest, so they
  // are never compiled into the published dist/. The helpers matter as much as
  // the tests here: they import vitest, which is not a runtime dependency.
  "exclude": ["src/**/*.test.ts", "src/**/*.test-helpers.ts"]
}
